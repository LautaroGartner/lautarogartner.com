SESSION_SECRET=generate-with-openssl-rand-base64-48
ADMIN_GITHUB_USER_ID=158626277
GITHUB_OAUTH_CLIENT_ID=github-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=github-oauth-app-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://www.lautarogartner.com/api/auth-callback
GITHUB_TOKEN=github-fine-grained-token-with-contents-write
GITHUB_OWNER=LautaroGartner
GITHUB_REPO=lautarogartner.com
GITHUB_BRANCH=main
# Development only; ignored in production.
LOCAL_ADMIN_PASSWORD=local-paideia

# Enquiry delivery (server only). Configure an existing approved Resend account
# and verified sender before enabling the form; no credentials belong in client code.
RESEND_API_KEY=
ENQUIRY_FROM=
# Optional dedicated signing secret; otherwise uses existing SESSION_SECRET.
ENQUIRY_SECRET=
# Recipient is intentionally fixed to lautaro@lautarogartner.com in api/enquiry.mjs.

# Public GA4 web-stream measurement ID. Only emitted when configured; no API secret.
# Review the free property's settings and visitor consent behavior before enabling.
GA_MEASUREMENT_ID=
